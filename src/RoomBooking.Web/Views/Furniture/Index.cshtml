@using RoomBooking.Core.Facilities.Furniture
@model IReadOnlyList<FurnitureItem>
@{
    ViewData["Title"] = "Furniture";
}
<h1>Furniture</h1>
<p><a href="/Furniture/Orders">My Furniture orders</a> · <a href="/Furniture/Report">Furniture report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Furniture/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
