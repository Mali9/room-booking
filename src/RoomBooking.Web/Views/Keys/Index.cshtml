@using RoomBooking.Core.Facilities.Keys
@model IReadOnlyList<KeysItem>
@{
    ViewData["Title"] = "Keys";
}
<h1>Keys</h1>
<p><a href="/Keys/Orders">My Keys orders</a> · <a href="/Keys/Report">Keys report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Keys/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
