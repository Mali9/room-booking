@using RoomBooking.Core.Facilities.Badges
@model IReadOnlyList<BadgesItem>
@{
    ViewData["Title"] = "Badges";
}
<h1>Badges</h1>
<p><a href="/Badges/Orders">My Badges orders</a> · <a href="/Badges/Report">Badges report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Badges/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
