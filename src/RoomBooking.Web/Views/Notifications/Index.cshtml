@model IReadOnlyList<Notification>
@{
    ViewData["Title"] = "Notifications";
    var unreadIds = (HashSet<int>)ViewBag.UnreadIds;
}
<h1>Notifications</h1>
@if (Model.Count == 0)
{
    <p>No notifications.</p>
}
else
{
    <ul id="notifications" class="notifications">
        @foreach (var item in Model)
        {
            <li class="@(unreadIds.Contains(item.Id) ? "unread" : "")">
                @if (unreadIds.Contains(item.Id))
                {
                    <strong>New:</strong>
                }
                @item.Message
                <span class="note">@Text.DateTime(item.CreatedAt)</span>
            </li>
        }
    </ul>
}
