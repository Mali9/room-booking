@using RoomBooking.Core.Facilities.Kitchen
@model IReadOnlyList<KitchenItem>
@{
    ViewData["Title"] = "Kitchen";
}
<h1>Kitchen</h1>
<p><a href="/Kitchen/Orders">My Kitchen orders</a> · <a href="/Kitchen/Report">Kitchen report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Kitchen/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
