@using RoomBooking.Core.Facilities.Parking
@model IReadOnlyList<ParkingItem>
@{
    ViewData["Title"] = "Parking";
}
<h1>Parking</h1>
<p><a href="/Parking/Orders">My Parking orders</a> · <a href="/Parking/Report">Parking report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Parking/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
