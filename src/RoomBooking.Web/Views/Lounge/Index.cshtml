@using RoomBooking.Core.Facilities.Lounge
@model IReadOnlyList<LoungeItem>
@{
    ViewData["Title"] = "Lounge";
}
<h1>Lounge</h1>
<p><a href="/Lounge/Orders">My Lounge orders</a> · <a href="/Lounge/Report">Lounge report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Lounge/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
