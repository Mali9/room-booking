@using RoomBooking.Core.Facilities.Cleaning
@model IReadOnlyList<CleaningItem>
@{
    ViewData["Title"] = "Cleaning";
}
<h1>Cleaning</h1>
<p><a href="/Cleaning/Orders">My Cleaning orders</a> · <a href="/Cleaning/Report">Cleaning report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Cleaning/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
