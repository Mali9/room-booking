@using RoomBooking.Core.Facilities.Pantry
@model IReadOnlyList<PantryItem>
@{
    ViewData["Title"] = "Pantry";
}
<h1>Pantry</h1>
<p><a href="/Pantry/Orders">My Pantry orders</a> · <a href="/Pantry/Report">Pantry report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Pantry/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
