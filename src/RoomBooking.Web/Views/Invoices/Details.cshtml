@model Invoice
@{
    ViewData["Title"] = $"Invoice {Model.Id}";
}
<h1>Invoice @Model.Id</h1>
<dl class="details">
    <dt>Booking</dt>
    <dd><a href="/Bookings/Details/@Model.BookingId">@Model.BookingId</a></dd>
    <dt>Type</dt>
    <dd>@(Model.Kind == InvoiceKind.Booking ? "Booking" : "Cancellation fee")</dd>
    <dt>Status</dt>
    <dd id="invoice-status">@Model.Status</dd>
    <dt>Issued</dt>
    <dd>@Text.DateTime(Model.IssuedAt)</dd>
</dl>
<table id="invoice-lines">
    <thead>
    <tr>
        <th>Description</th>
        <th>Amount</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var line in Model.Lines)
    {
        <tr>
            <td>@line.Description</td>
            <td>@Text.Money(line.Amount)</td>
        </tr>
    }
    </tbody>
    <tfoot>
    <tr>
        <th>Subtotal</th>
        <td id="invoice-subtotal">@Text.Money(Model.Subtotal)</td>
    </tr>
    <tr>
        <th>VAT (15%)</th>
        <td id="invoice-vat">@Text.Money(Model.Vat)</td>
    </tr>
    <tr>
        <th>Total</th>
        <td id="invoice-total">@Text.Money(Model.Total)</td>
    </tr>
    </tfoot>
</table>
<p><a href="/Invoices">Back to invoices</a></p>
