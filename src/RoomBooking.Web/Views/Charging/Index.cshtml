@using RoomBooking.Core.Facilities.Charging
@model IReadOnlyList<ChargingItem>
@{
    ViewData["Title"] = "Charging";
}
<h1>Charging</h1>
<p><a href="/Charging/Orders">My Charging orders</a> · <a href="/Charging/Report">Charging report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Charging/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
