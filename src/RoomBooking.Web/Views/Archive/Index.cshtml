@using RoomBooking.Core.Facilities.Archive
@model IReadOnlyList<ArchiveItem>
@{
    ViewData["Title"] = "Archive";
}
<h1>Archive</h1>
<p><a href="/Archive/Orders">My Archive orders</a> · <a href="/Archive/Report">Archive report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Archive/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
