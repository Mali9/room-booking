@using RoomBooking.Core.Facilities.Garden
@model IReadOnlyList<GardenItem>
@{
    ViewData["Title"] = "Garden";
}
<h1>Garden</h1>
<p><a href="/Garden/Orders">My Garden orders</a> · <a href="/Garden/Report">Garden report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Garden/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
