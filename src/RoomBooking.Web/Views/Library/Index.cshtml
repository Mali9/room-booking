@using RoomBooking.Core.Facilities.Library
@model IReadOnlyList<LibraryItem>
@{
    ViewData["Title"] = "Library";
}
<h1>Library</h1>
<p><a href="/Library/Orders">My Library orders</a> · <a href="/Library/Report">Library report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Library/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
