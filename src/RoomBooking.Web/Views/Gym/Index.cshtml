@using RoomBooking.Core.Facilities.Gym
@model IReadOnlyList<GymItem>
@{
    ViewData["Title"] = "Gym";
}
<h1>Gym</h1>
<p><a href="/Gym/Orders">My Gym orders</a> · <a href="/Gym/Report">Gym report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Gym/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
