@using RoomBooking.Core.Facilities.Bikes
@model IReadOnlyList<BikesOrder>
@{
    ViewData["Title"] = "My Bikes orders";
}
<h1>My Bikes orders</h1>
@if (Model.Count == 0)
{
    <p>No orders yet.</p>
}
else
{
    <table id="orders">
        <thead>
        <tr><th>Order</th><th>Item</th><th>Quantity</th><th>Total (incl. VAT)</th></tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.ItemId</td>
                <td>@order.Quantity</td>
                <td>@Text.Money(order.Total)</td>
            </tr>
        }
        </tbody>
    </table>
}
