@using RoomBooking.Core.Facilities.Bikes
@model IReadOnlyList<BikesItem>
@{
    ViewData["Title"] = "Bikes";
}
<h1>Bikes</h1>
<p><a href="/Bikes/Orders">My Bikes orders</a> · <a href="/Bikes/Report">Bikes report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Bikes/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
