@using RoomBooking.Core.Facilities.Uniforms
@model IReadOnlyList<UniformsItem>
@{
    ViewData["Title"] = "Uniforms";
}
<h1>Uniforms</h1>
<p><a href="/Uniforms/Orders">My Uniforms orders</a> · <a href="/Uniforms/Report">Uniforms report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Uniforms/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
