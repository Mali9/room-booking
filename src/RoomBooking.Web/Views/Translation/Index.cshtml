@using RoomBooking.Core.Facilities.Translation
@model IReadOnlyList<TranslationItem>
@{
    ViewData["Title"] = "Translation";
}
<h1>Translation</h1>
<p><a href="/Translation/Orders">My Translation orders</a> · <a href="/Translation/Report">Translation report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Translation/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
