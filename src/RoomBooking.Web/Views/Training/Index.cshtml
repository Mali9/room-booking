@using RoomBooking.Core.Facilities.Training
@model IReadOnlyList<TrainingItem>
@{
    ViewData["Title"] = "Training";
}
<h1>Training</h1>
<p><a href="/Training/Orders">My Training orders</a> · <a href="/Training/Report">Training report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Training/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
