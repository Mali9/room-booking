@using RoomBooking.Core.Facilities.Wellness
@model IReadOnlyList<WellnessItem>
@{
    ViewData["Title"] = "Wellness";
}
<h1>Wellness</h1>
<p><a href="/Wellness/Orders">My Wellness orders</a> · <a href="/Wellness/Report">Wellness report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Wellness/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
