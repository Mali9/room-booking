@using RoomBooking.Core.Facilities.Storage
@model IReadOnlyList<StorageItem>
@{
    ViewData["Title"] = "Storage";
}
<h1>Storage</h1>
<p><a href="/Storage/Orders">My Storage orders</a> · <a href="/Storage/Report">Storage report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Storage/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
