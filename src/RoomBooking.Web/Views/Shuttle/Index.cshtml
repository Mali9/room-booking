@using RoomBooking.Core.Facilities.Shuttle
@model IReadOnlyList<ShuttleItem>
@{
    ViewData["Title"] = "Shuttle";
}
<h1>Shuttle</h1>
<p><a href="/Shuttle/Orders">My Shuttle orders</a> · <a href="/Shuttle/Report">Shuttle report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Shuttle/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
