@{
    ViewData["Title"] = "Home";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<h1>Meeting room booking</h1>
@if (!signedIn)
{
    <p>Sign in to find and book a meeting room.</p>
    <p><a class="button" href="/Account/Login">Sign in</a></p>
}
else if (User.IsInRole("Admin"))
{
    <p>Welcome, @User.Identity!.Name. Manage rooms and review all bookings.</p>
    <ul>
        <li><a href="/Rooms">Manage rooms</a></li>
        <li><a href="/Bookings">All bookings</a></li>
        <li><a href="/Invoices">All invoices</a></li>
    </ul>
}
else
{
    <p>Welcome, @User.Identity!.Name.</p>
    <ul>
        <li><a href="/Bookings/Search">Find a room</a></li>
        <li><a href="/Bookings">My bookings</a></li>
        <li><a href="/Invoices">My invoices</a></li>
    </ul>
}
<section class="rules">
    <h2>Booking rules</h2>
    <ul>
        <li>Bookings start on the hour, last 1 to 8 hours, and run between 08:00 and 22:00.</li>
        <li>Peak hours are Sunday to Thursday, 09:00 to 17:00, at 1.5 times the hourly rate.</li>
        <li>Bookings of 4 hours or more get a 10% discount.</li>
        <li>VAT of 15% is added to every invoice.</li>
        <li>Cancelling at least 24 hours before the start is free. Later cancellations cost 50% of the booking price.</li>
    </ul>
</section>
