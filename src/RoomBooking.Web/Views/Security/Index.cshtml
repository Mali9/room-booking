@using RoomBooking.Core.Facilities.Security
@model IReadOnlyList<SecurityItem>
@{
    ViewData["Title"] = "Security";
}
<h1>Security</h1>
<p><a href="/Security/Orders">My Security orders</a> · <a href="/Security/Report">Security report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Security/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
