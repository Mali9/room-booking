@using RoomBooking.Core.Facilities.Courier
@model IReadOnlyList<CourierItem>
@{
    ViewData["Title"] = "Courier";
}
<h1>Courier</h1>
<p><a href="/Courier/Orders">My Courier orders</a> · <a href="/Courier/Report">Courier report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Courier/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
