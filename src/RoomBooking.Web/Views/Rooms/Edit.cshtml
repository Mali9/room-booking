@model RoomFormViewModel
@{
    var creating = Model.Id is null;
    ViewData["Title"] = creating ? "Add room" : "Edit room";
}
<h1>@ViewData["Title"]</h1>
<form method="post" action="@(creating ? "/Rooms/Create" : $"/Rooms/Edit/{Model.Id}")" asp-antiforgery="true" class="form">
    <div asp-validation-summary="All" class="alert error" role="alert"></div>
    @if (!creating)
    {
        <p>Room ID: <strong>@Model.Id</strong></p>
    }
    <label for="Name">Name</label>
    <input asp-for="Name" />
    <label for="Capacity">Capacity</label>
    <input asp-for="Capacity" type="number" />
    <label for="HourlyRate">Hourly rate (SAR)</label>
    <input asp-for="HourlyRate" type="number" step="0.01" />
    <button type="submit">@(creating ? "Create room" : "Save changes")</button>
    <a href="/Rooms">Cancel</a>
</form>
