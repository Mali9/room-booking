@using RoomBooking.Core.Facilities.Events
@model IReadOnlyList<EventsItem>
@{
    ViewData["Title"] = "Events";
}
<h1>Events</h1>
<p><a href="/Events/Orders">My Events orders</a> · <a href="/Events/Report">Events report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Events/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
