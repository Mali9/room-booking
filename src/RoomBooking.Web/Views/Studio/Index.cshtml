@using RoomBooking.Core.Facilities.Studio
@model IReadOnlyList<StudioItem>
@{
    ViewData["Title"] = "Studio";
}
<h1>Studio</h1>
<p><a href="/Studio/Orders">My Studio orders</a> · <a href="/Studio/Report">Studio report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Studio/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
