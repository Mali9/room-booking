@using RoomBooking.Core.Facilities.Lockers
@model IReadOnlyList<LockersItem>
@{
    ViewData["Title"] = "Lockers";
}
<h1>Lockers</h1>
<p><a href="/Lockers/Orders">My Lockers orders</a> · <a href="/Lockers/Report">Lockers report</a></p>
<table id="items">
    <thead>
    <tr><th>Item</th><th>Unit price</th><th>Available</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@Text.Money(item.UnitPrice)</td>
            <td>@item.Capacity</td>
            <td><a href="/Lockers/Quote?itemId=@item.Id&quantity=1">Order</a></td>
        </tr>
    }
    </tbody>
</table>
